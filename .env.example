# ============================================================
# CONFIGURATION DE LA BOUTIQUE
# ============================================================
# 1. Copiez ce fichier et renommez la copie ".env"
#      cp .env.example .env
# 2. Remplacez chaque valeur entre [CROCHETS] par votre vraie information.
# 3. Ne partagez JAMAIS votre fichier .env (il contient vos identifiants admin).
# ============================================================

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Identité de la boutique ---
STORE_NAME=[NOM DE LA BOUTIQUE]
STORE_TAGLINE=Produits de hijama, massage et bien-être

# --- WhatsApp ---
# Format international SANS "+" ni espaces, ex: 212612345678
WHATSAPP_NUMBER=[NUMERO WHATSAPP]

# --- Réseaux sociaux (liens complets, ex: https://instagram.com/votre_compte) ---
INSTAGRAM_URL=[LIEN INSTAGRAM]
FACEBOOK_URL=[LIEN FACEBOOK]
TIKTOK_URL=[LIEN TIKTOK]

# --- Commerce ---
CURRENCY=DH
DELIVERY_COUNTRY=Maroc
# Frais de livraison par défaut si la ville n'est pas dans la liste (voir espace admin > Livraison)
DEFAULT_DELIVERY_FEE=30

# --- Espace admin (/admin) ---
# Choisissez un identifiant et un mot de passe UNIQUEMENT pour vous.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=[CHOISISSEZ_UN_MOT_DE_PASSE_FORT]
# Clé secrète utilisée pour sécuriser les sessions admin : mettez n'importe quelle longue chaîne aléatoire
SESSION_SECRET=[UNE_CHAINE_ALEATOIRE_LONGUE_ET_SECRETE]

# --- Export automatique des commandes vers Google Sheets (optionnel) ---
# Laissez vide pour désactiver. Voir la section "Google Sheets" du README
# pour créer l'URL en 5 minutes (Google Apps Script, aucun compte développeur).
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Notification par email à chaque nouvelle commande (optionnel) ---
# Laissez NOTIFY_EMAIL_USER vide pour désactiver. Utilise un compte Gmail :
# NOTIFY_EMAIL_USER = votre adresse Gmail complète
# NOTIFY_EMAIL_APP_PASSWORD = un "mot de passe d'application" Gmail (16 caractères,
#   généré sur myaccount.google.com/apppasswords — nécessite la validation en 2 étapes),
#   PAS votre mot de passe Gmail normal.
# NOTIFY_EMAIL_TO = adresse qui reçoit les notifications (laissez vide pour recevoir
#   sur NOTIFY_EMAIL_USER lui-même)
NOTIFY_EMAIL_USER=
NOTIFY_EMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=
