# ============================================================
# CONFIGURATION DE LA BOUTIQUE
# ============================================================
# 1. Copiez ce fichier et renommez la copie ".env"
#      cp .env.example .env
# 2. Remplacez chaque valeur entre [CROCHETS] par votre vraie information.
# 3. Ne partagez JAMAIS votre fichier .env (il contient vos identifiants admin).
# ============================================================

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Identité de la boutique ---
STORE_NAME=[NOM DE LA BOUTIQUE]
STORE_TAGLINE=Produits de hijama, massage et bien-être

# --- WhatsApp ---
# Format international SANS "+" ni espaces, ex: 212612345678
WHATSAPP_NUMBER=[NUMERO WHATSAPP]

# --- Téléphone affiché (footer, page contact) ---
# Laissez vide pour réutiliser WHATSAPP_NUMBER tel quel (cas le plus courant).
# Ne renseignez PHONE_NUMBER que si vous avez un numéro d'appel différent.
PHONE_NUMBER=
# Horaires affichés à côté du téléphone, ex: Lun-Sam, 9h-19h. Laissez vide pour ne rien afficher.
STORE_HOURS=

# --- Réseaux sociaux (liens complets, ex: https://instagram.com/votre_compte) ---
INSTAGRAM_URL=[LIEN INSTAGRAM]
FACEBOOK_URL=[LIEN FACEBOOK]
TIKTOK_URL=[LIEN TIKTOK]

# --- Commerce ---
CURRENCY=DH
DELIVERY_COUNTRY=Maroc
# Frais de livraison par défaut si la ville n'est pas dans la liste (voir espace admin > Livraison)
DEFAULT_DELIVERY_FEE=30

# --- Espace admin (/admin) ---
# Choisissez un identifiant et un mot de passe UNIQUEMENT pour vous.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=[CHOISISSEZ_UN_MOT_DE_PASSE_FORT]
# Clé secrète utilisée pour sécuriser les sessions admin : mettez n'importe quelle longue chaîne aléatoire
SESSION_SECRET=[UNE_CHAINE_ALEATOIRE_LONGUE_ET_SECRETE]

# --- Export automatique des commandes vers Google Sheets (optionnel) ---
# Laissez vide pour désactiver. Voir la section "Google Sheets" du README
# pour créer l'URL en 5 minutes (Google Apps Script, aucun compte développeur).
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Notification par email à chaque nouvelle commande (optionnel) ---
# Laissez NOTIFY_EMAIL_USER vide pour désactiver. Utilise un compte Gmail :
# NOTIFY_EMAIL_USER = votre adresse Gmail complète
# NOTIFY_EMAIL_APP_PASSWORD = un "mot de passe d'application" Gmail (16 caractères,
#   généré sur myaccount.google.com/apppasswords — nécessite la validation en 2 étapes),
#   PAS votre mot de passe Gmail normal.
# NOTIFY_EMAIL_TO = adresse qui reçoit les notifications (laissez vide pour recevoir
#   sur NOTIFY_EMAIL_USER lui-même)
NOTIFY_EMAIL_USER=
NOTIFY_EMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=

# --- Avis "DEMO" livrés avec le site (voir backend/db/seed.js) ---
# Masqués aux visiteurs par défaut tant qu'aucun vrai avis n'existe. Mettez
# true pour les réafficher temporairement (test de mise en page uniquement).
SHOW_DEMO_REVIEWS=false

# --- Meta Pixel + Conversions API (suivi des commandes pour les pubs Facebook/Instagram) ---
# META_PIXEL_ID : identifiant du pixel (visible dans Meta Events Manager, pas secret).
# META_CAPI_ACCESS_TOKEN : jeton d'accès "Conversions API" (SECRET, ne le partagez jamais).
#   Se génère dans Meta Events Manager > votre pixel > Paramètres > Conversions API >
#   "Générer un token d'accès manuellement". Laissez vide pour désactiver le suivi
#   côté serveur (le pixel navigateur continue de fonctionner seul).
META_PIXEL_ID=8482376721812747
META_CAPI_ACCESS_TOKEN=

# --- TikTok Pixel + Events API (mêmes principes que Meta ci-dessus) ---
# Se crée dans TikTok Ads Manager > Ressources > Évènements > Configurer un pixel web.
# TIKTOK_ACCESS_TOKEN : Ressources > Évènements > votre pixel > Générer un token API.
# Laissez les deux vides pour désactiver le tracking TikTok (aucun impact ailleurs).
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# --- Landing page /pack-hajjam-pro ---
# Le pack "Hajjam Pro" est un produit normal créé une fois dans l'admin — ce
# slug doit correspondre exactement à celui donné au produit à sa création.
PACK_PRODUCT_SLUG=pack-hajjam-pro
# Remise accordée sur le 2e pack quand le client en commande 2 (en DH).
PACK_SECOND_UNIT_DISCOUNT=49
# ID du produit proposé en upsell sur la page du pack (mesdras tedlik faciale, 140 DH).
PACK_UPSELL_PRODUCT_ID=95
